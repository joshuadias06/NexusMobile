<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Fundo de Gelo Brilhante -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:startColor="#B0DAFF"
                android:centerColor="#A1C8FF"
                android:endColor="#8BBEFF"
                android:angle="270"/>
            <corners android:radius="14dp"/>
            <stroke android:width="2dp" android:color="#C3E0FF"/>
        </shape>
    </item>

    <!-- Efeito de brilho interno (leve) -->
    <item android:right="4dp" android:left="4dp" android:top="2dp" android:bottom="2dp">
        <shape android:shape="rectangle">
            <solid android:color="#E0FFFF" />
            <corners android:radius="14dp"/>
        </shape>
    </item>
</layer-list>
