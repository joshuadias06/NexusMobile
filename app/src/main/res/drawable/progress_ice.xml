<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Fundo da barra -->
    <item android:id="@android:id/background">
        <shape android:shape="rectangle">
            <solid android:color="#334C77" />
            <corners android:radius="10dp"/>
        </shape>
    </item>

    <!-- Barra de progresso -->
    <item android:id="@android:id/progress">
        <clip>
            <shape android:shape="rectangle">
                <gradient
                    android:angle="0"
                    android:startColor="#B0DAFF"
                    android:centerColor="#A0CFFF"
                    android:endColor="#80BFFF"
                    android:type="linear"/>
                <corners android:radius="10dp"/>
            </shape>
        </clip>
    </item>
</layer-list>
